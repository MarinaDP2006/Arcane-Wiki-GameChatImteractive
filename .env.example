# Servidor del roleplay de Arcane (server/roleplay-server.js).
# Configúralo en el panel del alojamiento (Render), nunca en el navegador ni en GitHub.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
#
# Alternativa: API compatible con OpenAI. Para LM Studio en el mismo ordenador que el servidor:
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_MODEL=<identificador-exacto-que-muestra-LM-Studio>
# AI_API_KEY= (vacío si LM Studio no tiene autenticación)
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
ROLEPLAY_RPM=20
# Orígenes web permitidos, separados por comas (vacío = cualquiera).
ALLOWED_ORIGINS=
PORT=10000
