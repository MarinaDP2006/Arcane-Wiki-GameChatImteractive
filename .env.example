# La única IA del juego es KoboldCpp. Dirección del KoboldCpp al que reenvía el servidor web
# (sin la ruta /v1). Por defecto, el del mismo equipo. No lo abras a Internet pública sin protección.
KOBOLDCPP_URL=http://127.0.0.1:5001
# Nombre del modelo que se envía a KoboldCpp (KoboldCpp usa el que tenga abierto).
KOBOLDCPP_MODEL=koboldcpp
ROLEPLAY_MAX_PER_HOUR=24
# Orígenes adicionales separados por comas, solo si el cliente vive en otro dominio.
ROLEPLAY_ALLOWED_ORIGINS=
PORT=10000
