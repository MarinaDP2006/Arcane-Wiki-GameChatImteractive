# Proveedor OpenAI-compatible. Para LM Studio local en el mismo equipo:
# AI_PROVIDER=lm-studio
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_MODEL=qwen3-0.6b
# AI_API_KEY= (vacío si LM Studio no tiene autenticación)
#
# Para Ollama Cloud, dejar AI_BASE_URL sin definir y usar:
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Opcional: proveedor alternativo compatible con /v1/chat/completions
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
ROLEPLAY_MAX_PER_HOUR=24
# Orígenes adicionales separados por comas, solo si el cliente vive en otro dominio.
ROLEPLAY_ALLOWED_ORIGINS=
PORT=10000
