{
  "name": "grietas-and-gears",
  "productName": "Grietas & Gears",
  "version": "1.22.0",
  "description": "Grietas & Gears, juego de fans de Arcane: historia interactiva, conversaciones con opciones de diálogo y mundo abierto de Piltover y Zaun.",
  "main": "main.js",
  "author": "MarinaDP2006",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/asegurar-electron.js",
    "check": "node scripts/check.js && node scripts/check-runtime.js",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "android:sync": "node scripts/build-mobile.js && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.marinadp2006.arcanewikigame",
    "productName": "Grietas & Gears",
    "files": [
      "main.js",
      "modelos.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Grietas & Gears",
      "artifactName": "Grietas-and-Gears-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Grietas-and-Gears-${version}-portable.${ext}"
    }
  }
}
